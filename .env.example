# انسخ الملف ده باسم ".env" واكتب فيه القيم بتاعتك. ممنوع ترفع ملف .env على أي مكان عام.
# كل القيم اختيارية ما عدا اللي محتاجه للميزة اللي عايز تفعّلها.

# ─── السيرفر ───────────────────────────────────────────
PORT=3000
# محليًا السيرفر بيفتح على جهازك بس (127.0.0.1). على استضافة اكتب 0.0.0.0 (Render بيعملها لوحده).
# HOST=127.0.0.1
# مكان حفظ قاعدة البيانات والصور المصغرة ومفاتيح الإشعارات. على استضافة لازم يشاور على قرص دائم (Persistent Disk).
# DATA_DIR=./data
# لو مش عايز الجدول الجاهز (4 قنوات + 24 مهمة) يتحمّل أول مرة:
# SEED_DEMO=false

# ─── الأمان ────────────────────────────────────────────
# كلمة سر تصفير الأسبوع. لو سبتها فاضية بتشتغل بـ "changeme" — غيّرها.
RESET_PASSWORD=
# تسجيل دخول للموقع كله (مهم جدًا لو الموقع منشور على الإنترنت، عشان محدش يستهلك رصيد الـ AI بتاعك):
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=

# ─── الذكاء الاصطناعي: كتابة العناوين (واحد على الأقل) ───
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# المزوّد المفضّل لو متضاف أكتر من مفتاح: anthropic | gemini | openai
# AI_PROVIDER=

# ─── الصور المصغرة (Thumbnails) ────────────────────────
# بتتولّد بـ Gemini API (موديلات الصور بتاعت Google) — محتاجة GEMINI_API_KEY من https://aistudio.google.com
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ─── إشعارات التذكير اليومي (Web Push) ─────────────────
# بتتولّد تلقائيًا في data/vapid.json أول مرة. على استضافة من غير قرص دائم اكتبها هنا عشان متتغيرش:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional OpenRouter-compatible model access
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=
